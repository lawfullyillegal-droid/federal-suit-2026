formulas(assumptions).
  % Define the rules of your Sovereign Declaration
  Sovereign(Travis_Ryle).
  Trust(Private_Bank_Estate_and_Trust).
  Authorized(Travis_Ryle, Private_Bank_Estate_and_Trust).

  % Rule: If an authorized sovereign claims an entity, it exists legally
  all x all y (Sovereign(x) & Authorized(x, y) -> Legally_Exists(y)).
end_of_list.

formulas(goals).
  % The conclusion you want Prover9 to prove
  Legally_Exists(Private_Bank_Estate_and_Trust).
end_of_list.
