# ========================================
# .gitignore — Federal Suit 2026 Archive
# Excludes local environment & system files
# ========================================

# Shell / local environment config (NEVER commit these)
.android/
.cache/
.cargo/
.config/
.gnupg/
.local/
.npm/
.nvm/
.ollama/
.ssh/
.termux/
.devcontainer/

# OS system files
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env
venv/
.venv/
*.egg-info/
dist/
build/

# Node
node_modules/
npm-debug.log

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# Logs (unless intentional evidence logs)
*.log

# Temporary/scratch files
*.tmp
*.bak
scratch/
draft_working/

# Local databases (not evidence CSVs)
*.db
*.sqlite
