{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deep Scan Results",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["text", "url"],
    "properties": {
      "text": {"type": "string", "minLength": 1},
      "url": {"type": "string", "format": "uri"},
      "source": {"type": "string"},
      "context": {"type": "string"}
    },
    "additionalProperties": false
  },
  "minItems": 0
}
