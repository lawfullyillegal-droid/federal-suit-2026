<style>
/* Used to remove border from tables if desired */
.component-inner table, .component-inner td, .component-inner th, .component-inner tr {
    border:none
}
.component-inner tr:nth-of-type(odd) {
    background-color: rgba(0, 0, 0, .05);
}
/* Prevent extra bolding when moving over old site content */
h3, h3 strong {
    font-weight: normal !important;
}
/* Used to put headshots next to profiles */
.pod-max-image-size img {
    max-width: 180px !important;
}
iframe {
    width:100%; height: 700px; box-shadow: none !important;
    
}

.usn_cmp_subpagelisting  .component-inner .item .inner {
    border-left: none;
    padding-left: 14px;
    position:relative;
}
.usn_cmp_subpagelisting  .component-inner .item .inner:before {
    content: "\f3d1";
    display: inline-block;
    font-family: "Ionicons";
    position:absolute;
    opacity:0.6;
    left:0;
}
.prestige-icon-row .row .inner .image {
    width: 70px !important;
    height: 70px !important;
}
/* separate header and footer with a shaddow */
footer {
    -webkit-box-shadow: 0px -7px 15px -4px rgba(0,0,0,0.39); 
    box-shadow: 0px -7px 15px -4px rgba(0,0,0,0.39);
}
header {
    -webkit-box-shadow: 0px 7px 15px -4px rgba(0,0,0,0.63) !important; 
    box-shadow: 0px 7px 15px -4px rgba(0,0,0,0.63) !important;
}
/* drop shaddow for images that are white */
.dropshaddowed .item .image {
    position: relative;
    z-index: 0;
    border: 1px solid #e7e7e7;
    box-shadow: 0px 0px 4px 0px rgba(0, 0, 0, 0.15);
}
/* More of an obvious link on hover for image links */
body.content-underline-link-hover #site-content .item a:not(.btn):not(.nav-button-link):hover {
    text-decoration: underline !important;
    text-decoration-color: var(--base-secondary-heading) !important;
    color: var(--base-secondary-heading)
}

/* hide some image link grids on desktop but not on mobile */
@media screen and (min-width: 1100px) {
    .mobileOnly {
        display:none !important;
    }
}
/* for image grids, always force 2 columns on mobile*/
.imageTiles .item.items-2, .imageTiles .item.items-3, .imageTiles .item.items-4, .imageTiles .item.items-5, .imageTiles .item.items-6 {
    flex: 0 0 var(--items-2);
    -ms-flex: 0 0 var(--items-2) ;
    max-width: var(--items-2);
}
/* for icon grids, always force 2 columns on mobile*/
.grid-padding .grid-section > div {
    padding: 30px 0;
}
.grid-section h3 {
    margin-top:0 !important;
}

/* tabs that have the same colors as buttons */
.repeatable.tab-buttons .tab .nav-link:not(.active) {
    color: rgba(var(--base-btn-text), 1);
    border-color: rgba(var(--base-borders), 0.25);
    background: rgba(var(--base-btn-bg-color1), 1);
}
.repeatable.tab-buttons .tab .nav-link:not(.active):hover {
    color: rgba(var(--base-btn-text-hover), 1);
    border-color: rgba(var(--base-btn-borders-hover), 1);
    background: none;
}
/* hides image for print pages */
@media print {
    .removeImgPrint {
        img {
            display:none !important; 
        }
    }
}
/* hides item for print pages */
@media print {
    .removeItemPrint, .imageTiles  {
        display:none !important; 
    }
}

</style>


