<script>
const hash = window.location.hash;
if (hash) {
  const anchor = document.querySelector(`${hash}`);
  if (anchor && anchor.parentElement) {
    anchor.parentElement.style.backgroundColor = '#F2D601';
  }
};
$(function(){
    /* accessibility fix */
    $('#modal_2014').removeAttr('aria-labelledby');
    $('.gs-feed-list-news').attr('aria-labelledby', 'gs-feed-header');
    $('.default_search_field fieldset').prepend('<legend style="display:none">Search</legend>');
    $('#logo a').removeAttr('title');
    $('#gs-feed-header').removeAttr('id');
    $('#gs-subnav-desktop').removeAttr('aria-label');
    $('.main.base-heading').after('<h2 class="page-second-header" style="display:none">Mohave County</h2>');
    $('a').click(function( event ) {
        const dialogEl = $(this)
        const url = $(this).attr('href')
        if(url.includes('http')){
            const urlObject = new URL(url)
            if(
                !url.includes('mailto:') && 
                !url.includes('tel:') && 
                !urlObject.hostname.includes('mohave.gov') && 
                !urlObject.hostname.includes('mohavecounty.us') && 
                !urlObject.hostname.includes('az-mohave.opendata.arcgis.com') && 
                !urlObject.hostname.includes('mohavecountyaz.mycusthelp.com') && 
                !urlObject.hostname.includes('mohave-002-us.govstack.com') && 
                !urlObject.hostname.includes('mohavecountylibrary.us') && 
                !urlObject.hostname.includes('mohavecourts.com') && 
                !url.includes('aca-prod.accela.com/MOHAVE/') && 
                !urlObject.hostname.includes('mohave.maps.arcgis.com')
            ){
                $('#site_owner').html(urlObject.hostname)
                event.preventDefault();    
                $("#dialog-confirm" ).dialog({
                  resizable: false,
                  height: "auto",
                  width: 400,
                  modal: true,
                  buttons: {
                    "Continue": function() {
                        window.open($(dialogEl).attr('href'));
                        $( this ).dialog( "close" );
                    },
                    Cancel: function() {
                      
                        $( this ).dialog( "close" );
                    }
                  }
                });
            }
        }
    });
})
</script>
