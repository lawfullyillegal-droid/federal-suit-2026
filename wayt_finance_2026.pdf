<script>
$(function(){
    const url = window.location.toString()
    if(url.includes("ContentPage.aspx?id=111&cid=1595")){
        const split = url.split("ContentPage.aspx?id=111&cid=1595")
        if(split[1]){
            window.location.href = '/departments/assessor/assessor-search/?new'+split[1]
        }
    } else if(url.includes("ContentPage.aspx?id=111&page=2&cid=106")){
        const split = url.split("ContentPage.aspx?id=111&page=2&cid=106")
        if(split[1]){
            window.location.href = '/departments/assessor/other-maps/railroad-maps/?new'+split[1]
        }
    } else if(url.includes("ContentPage.aspx?id=111&page=3&cid=106")){
        const split = url.split("ContentPage.aspx?id=111&page=3&cid=106")
        if(split[1]){
            window.location.href = '/departments/assessor/other-maps/record-of-survey-maps/?new'+split[1]
        }
    } else if(url.includes("ContentPage.aspx?id=111&page=4&cid=106")){
        const split = url.split("ContentPage.aspx?id=111&page=4&cid=106")
        if(split[1]){
            window.location.href = '/departments/assessor/other-maps/right-of-way-maps/?new'+split[1]
        }
    } else if(url.includes("ContentPage.aspx?id=111&page=5&cid=106")){
        const split = url.split("ContentPage.aspx?id=111&page=5&cid=106")
        if(split[1]){
            window.location.href = '/departments/assessor/other-maps/subdivision-maps/?new'+split[1]
        }
    } else if(url.includes("ContentPage.aspx?id=111&page=6&cid=106")){
        const split = url.split("ContentPage.aspx?id=111&page=6&cid=106")
        if(split[1]){
            window.location.href = '/departments/assessor/other-maps/survey-maps/?new'+split[1]
        }
    } else if(url.includes("ContentPage.aspx?id=111&page=1&cid=106")){
        const split = url.split("ContentPage.aspx?id=111&page=1&cid=106")
        if(split[1]){
            window.location.href = '/departments/assessor/other-maps/parcel-plat-maps/?new'+split[1]
        }
    } else{
        //log404()
    }
})
async function log404(){
    const params = new URLSearchParams()
    const paramsRef = new URLSearchParams()
    params.set('referrer', window.location)
    paramsRef.set('referrer', window.location+' '+document.referrer)
    if(
        window.location.href === 'https://www.mohave.gov/ContentPage.aspx?id=131&cid=81' ||
        window.location.href === 'https://www.mohave.gov/ContentPage.aspx?id=111&cid=1019' || 
        window.location.href === 'https://www.mohave.gov/ContentPage.aspx?id=111&cid=869' || 
        window.location.href === 'https://www.mohave.gov/ContentPage.aspx?id=111&cid=1402'
    ){
        return
    }
    await fetch(`https://appsweb.mohave.gov/clerk/api/notfound?ref=1&${paramsRef.toString()}`)
}
</script>
    
