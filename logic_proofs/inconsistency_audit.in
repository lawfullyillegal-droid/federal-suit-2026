
formulas(assumptions).
  % Entity mapping: `travis_ryle_private_bank_estate_and_trust` represents
  % the human-readable name "The Travis Ryle Private Bank Estate & Trust".
  % 1. UCC Rule: Absence of agreement means status is FALSE.
  -SecurityAgreement(travis_ryle_private_bank_estate_and_trust) -> -CorporateDebtor(travis_ryle_private_bank_estate_and_trust).

  % 2. Definition: A report of a status that is FALSE is a contradiction.
  ReportedAs(defendant, travis_ryle_private_bank_estate_and_trust, corporate_status) & -CorporateDebtor(travis_ryle_private_bank_estate_and_trust) -> Contradiction.

  % 3. Current Fact: No agreement exists.
  -SecurityAgreement(travis_ryle_private_bank_estate_and_trust).

  % 4. Defendant's Fact: They have reported the status.
  ReportedAs(defendant, travis_ryle_private_bank_estate_and_trust, corporate_status).
end_of_list.

formulas(goals).
  % Goal: Prove that a contradiction exists.
  Contradiction.
end_of_list.
