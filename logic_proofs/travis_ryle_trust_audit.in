formulas(assumptions).

% -- Existing Axioms --
all x (Trust_Record(x) -> Ministerial_Duty(x)).
all x (Ministerial_Duty(x) & Modified(x) & -Consent(x) -> Inconsistent_Act(x)).
all x (CorporateDebtor(x) -> PrivateTrust(x)).
all x (ReportedAs(x, y, z) -> IdentityConversion(x)).

% -- Targeted Facts --
CorporateDebtor(Mohave_County_Entity).
Modified(Mohave_County_Entity).
-Consent(Mohave_County_Entity).
Trust_Record(Mohave_County_Entity).

end_of_list.

formulas(goals).
% We are trying to prove that an Inconsistent Act MUST exist.
exists x (Inconsistent_Act(x)).
end_of_list.
