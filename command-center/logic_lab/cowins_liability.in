formulas(assumptions).
  % General Rules of Liability
  all x all y (Owner(x, y) & Activity(y, Felony) -> Responsible(x, y)).
  all x all y (Responsible(x, y) & FailedToCure(x) -> InDefault(x)).
  
  % Specific Evidence from your Forensic Record
